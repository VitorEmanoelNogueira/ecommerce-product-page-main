      "isDeleted": false,
      "boundElements": [],
      "updated": 1788024347319,
      "link": null,
      "locked": false,
      "text": "<section class=\"carousel\" role=\"region\" aria-roledescription=\"carousel\" aria-\nlabel=\"Featured Products\">\n  <!-- Live region to announce slide changes to screen readers -->\n  <div class=\"aria-live-status visually-hidden\" aria-live=\"polite\" aria-atomic=\"true\">\n</div>\n\n  <!-- Navigation Buttons -->\n  <div class=\"carousel-controls\">\n    <button class=\"carousel-btn prev-btn\" aria-label=\"Previous Slide\">◀</button>\n    <button class=\"carousel-btn next-btn\" aria-label=\"Next Slide\">▶</button>\n  </div>\n\n  <!-- Slides Track -->\n  <div class=\"carousel-track\" role=\"group\" aria-label=\"Slides\">\n    <!-- Slide 1 (Active) -->\n    <div class=\"carousel-slide active\" role=\"group\" aria-roledescription=\"slide\" aria-\nlabel=\"1 of 3\">\n      <img src=\"image1.jpg\" alt=\"A sleek black smartphone showing the home\nscreen.\">\n    </div>\n\n    <!-- Slide 2 (Hidden) -->\n    <div class=\"carousel-slide\" role=\"group\" aria-roledescription=\"slide\" aria-label=\"2\nof 3\" aria-hidden=\"true\">\n      <img src=\"image2.jpg\" alt=\"A silver laptop open on a wooden desk.\"\ntabindex=\"-1\">\n    </div>\n\n    <!-- Slide 3 (Hidden) -->\n    <div class=\"carousel-slide\" role=\"group\" aria-roledescription=\"slide\" aria-label=\"3\nof 3\" aria-hidden=\"true\">\n      <img src=\"image3.jpg\" alt=\"Wireless noise-canceling headphones resting on a\nstand.\" tabindex=\"-1\">\n    </div>\n  </div>\n</section>",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "<section class=\"carousel\" role=\"region\" aria-roledescription=\"carousel\" aria-label=\"Featured Products\">\n  <!-- Live region to announce slide changes to screen readers -->\n  <div class=\"aria-live-status visually-hidden\" aria-live=\"polite\" aria-atomic=\"true\"></div>\n\n  <!-- Navigation Buttons -->\n  <div class=\"carousel-controls\">\n    <button class=\"carousel-btn prev-btn\" aria-label=\"Previous Slide\">◀</button>\n    <button class=\"carousel-btn next-btn\" aria-label=\"Next Slide\">▶</button>\n  </div>\n\n  <!-- Slides Track -->\n  <div class=\"carousel-track\" role=\"group\" aria-label=\"Slides\">\n    <!-- Slide 1 (Active) -->\n    <div class=\"carousel-slide active\" role=\"group\" aria-roledescription=\"slide\" aria-label=\"1 of 3\">\n      <img src=\"image1.jpg\" alt=\"A sleek black smartphone showing the home screen.\">\n    </div>\n\n    <!-- Slide 2 (Hidden) -->\n    <div class=\"carousel-slide\" role=\"group\" aria-roledescription=\"slide\" aria-label=\"2 of 3\" aria-hidden=\"true\">\n      <img src=\"image2.jpg\" alt=\"A silver laptop open on a wooden desk.\" tabindex=\"-1\">\n    </div>\n\n    <!-- Slide 3 (Hidden) -->\n    <div class=\"carousel-slide\" role=\"group\" aria-roledescription=\"slide\" aria-label=\"3 of 3\" aria-hidden=\"true\">\n      <img src=\"image3.jpg\" alt=\"Wireless noise-canceling headphones resting on a stand.\" tabindex=\"-1\">\n    </div>\n  </div>\n</section>",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "wj1-SnRNlp5iLYIriLatt",
      "type": "text",
      "x": 6322.417698282949,
      "y": 2077.890774306642,
      "width": 758.0194091796875,
      "height": 625,
      "angle": 0,
