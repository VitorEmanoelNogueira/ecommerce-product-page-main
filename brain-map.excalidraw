    {
      "id": "3lrtxhnCjJ87PHuN8V9sq",
      "type": "text",
      "x": 5197.146335931386,
      "y": 1869.140774306642,
      "width": 792.7393798828125,
      "height": 900,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
